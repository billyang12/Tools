<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YXBToolsMAUI.Views.ErasePage"
             Title="Erase Files">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Header -->
            <Label Text="Secure File Erase"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <Label Text="⚠️ WARNING: This permanently destroys files by overwriting them with zeros before deletion. This cannot be undone!"
                   FontSize="14"
                   TextColor="Red"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20"/>

            <!-- Source Selection -->
            <Frame BorderColor="Gray" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Select File or Folder to Erase"
                           FontSize="16"
                           FontAttributes="Bold"/>

                    <HorizontalStackLayout Spacing="10">
                        <Button x:Name="SelectFileBtn"
                                Text="Select File"
                                BackgroundColor="#dc2626"
                                TextColor="White"
                                Clicked="OnSelectFileClicked"
                                HorizontalOptions="FillAndExpand"/>

                        <Button x:Name="SelectFolderBtn"
                                Text="Select Folder"
                                BackgroundColor="#dc2626"
                                TextColor="White"
                                Clicked="OnSelectFolderClicked"
                                HorizontalOptions="FillAndExpand"/>
                    </HorizontalStackLayout>

                    <Label x:Name="SelectedPathLabel"
                           Text="No file or folder selected"
                           TextColor="Gray"
                           FontSize="14"
                           LineBreakMode="CharacterWrap"
                           MaxLines="3"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Erase Method Selection -->
            <Frame BorderColor="Gray" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Erase Method"
                           FontSize="16"
                           FontAttributes="Bold"/>

                    <Picker x:Name="MethodPicker"
                            Title="Select erase method"
                            SelectedIndexChanged="OnMethodChanged">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Quick (1 pass) - Fast, sufficient for most needs</x:String>
                                <x:String>DoD 3-Pass - Good security, balanced speed</x:String>
                                <x:String>DoD 7-Pass - High security, slower</x:String>
                                <x:String>Gutmann 35-Pass - Maximum security, very slow</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>

                    <Label x:Name="MethodInfoLabel"
                           Text="Quick method overwrites with zeros once. Fast and sufficient for preventing casual recovery."
                           FontSize="12"
                           TextColor="Gray"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Folder Options -->
            <Frame BorderColor="Gray" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Folder Options"
                           FontSize="16"
                           FontAttributes="Bold"/>

                    <HorizontalStackLayout Spacing="10">
                        <CheckBox x:Name="IncludeSubfoldersCheckBox"
                                  IsChecked="False"
                                  CheckedChanged="OnIncludeSubfoldersChanged"/>
                        <Label Text="Include subfolders (recursive erase)"
                               FontSize="14"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Label x:Name="SubfolderWarningLabel"
                           Text="⚠️ WARNING: This will erase ALL files in ALL subfolders!"
                           FontSize="12"
                           TextColor="Red"
                           IsVisible="False"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Confirmation -->
            <Frame BorderColor="Red" Padding="15" BackgroundColor="#fee2e2">
                <VerticalStackLayout Spacing="10">
                    <Label Text="⚠️ Confirmation Required"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="Red"/>

                    <Label Text="Type 'ERASE' below to confirm you want to permanently destroy the selected files:"
                           FontSize="14"
                           TextColor="Red"/>

                    <Entry x:Name="ConfirmationEntry"
                           Placeholder="Type ERASE here"
                           TextColor="Red"
                           FontSize="16"
                           FontAttributes="Bold"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Progress -->
            <Frame x:Name="ProgressFrame"
                   IsVisible="False"
                   BorderColor="Gray"
                   Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="ProgressLabel"
                           Text="0 / 0 files"
                           FontSize="14"
                           HorizontalOptions="Center"/>

                    <ProgressBar x:Name="ProgressBar"
                                 Progress="0"
                                 ProgressColor="Red"/>

                    <Label x:Name="CurrentFileLabel"
                           Text=""
                           FontSize="12"
                           TextColor="Gray"
                           HorizontalOptions="Center"
                           LineBreakMode="TailTruncation"/>

                    <Label x:Name="PassProgressLabel"
                           Text=""
                           FontSize="12"
                           TextColor="Orange"
                           HorizontalOptions="Center"
                           FontAttributes="Bold"/>

                    <Button x:Name="CancelBtn"
                            Text="Cancel"
                            BackgroundColor="Orange"
                            TextColor="White"
                            Clicked="OnCancelClicked"
                            HorizontalOptions="Center"
                            WidthRequest="150"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Status -->
            <Label x:Name="StatusLabel"
                   Text=""
                   FontSize="14"
                   HorizontalOptions="Center"
                   FontAttributes="Bold"/>

            <!-- Erase Button -->
            <Button x:Name="EraseBtn"
                    Text="🔥 ERASE FILES 🔥"
                    BackgroundColor="#7f1d1d"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    Clicked="OnEraseClicked"
                    HeightRequest="60"
                    Margin="0,20,0,0"/>

            <!-- Info -->
            <Frame BorderColor="Gray" Padding="15" BackgroundColor="#f3f4f6">
                <VerticalStackLayout Spacing="8">
                    <Label Text="ℹ️ How it works:"
                           FontSize="14"
                           FontAttributes="Bold"/>
                    <Label Text="1. File is overwritten with patterns (multiple passes)"
                           FontSize="12"/>
                    <Label Text="2. Changes are flushed to disk"
                           FontSize="12"/>
                    <Label Text="3. File is permanently deleted (bypasses Recycle Bin)"
                           FontSize="12"/>
                    <Label Text="4. Recovery tools cannot restore the file"
                           FontSize="12"/>
                    <Label Text="5. File name does NOT appear in Recycle Bin"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="Green"/>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
