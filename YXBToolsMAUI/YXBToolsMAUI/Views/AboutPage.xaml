<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YXBToolsMAUI.Views.AboutPage"
             Title="About">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="30" VerticalOptions="Center">

            <!-- App Icon/Logo Area -->
            <Label Text="🛠️"
                   FontSize="72"
                   HorizontalOptions="Center"/>

            <!-- App Name -->
            <Label Text="YXB Tools"
                   FontSize="32"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>

            <!-- Version -->
            <Label x:Name="VersionLabel"
                   Text="Version 1.0.0"
                   FontSize="16"
                   TextColor="Gray"
                   HorizontalOptions="Center"/>

            <!-- Divider -->
            <BoxView HeightRequest="1"
                     BackgroundColor="LightGray"
                     Margin="0,10,0,10"/>

            <!-- Developer Info -->
            <VerticalStackLayout Spacing="10">
                <Label Text="Developed By"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>
                <Label Text="Bill Yang"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Divider -->
            <BoxView HeightRequest="1"
                     BackgroundColor="LightGray"
                     Margin="0,10,0,10"/>

            <!-- Description -->
            <Frame BorderColor="Gray" Padding="20" BackgroundColor="#f9fafb">
                <VerticalStackLayout Spacing="15">
                    <Label Text="About YXB Tools"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"/>

                    <Label Text="A comprehensive collection of utility tools for everyday tasks."
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="Gray"/>

                    <Label Text="Features:"
                           FontSize="14"
                           FontAttributes="Bold"
                           Margin="0,10,0,5"/>

                    <Label Text="• Secure File Erase - Military-grade file destruction with DoD and Gutmann methods"
                           FontSize="13"
                           LineBreakMode="WordWrap"/>

                    <Label Text="• Multi-Pass Overwrite - Choose from Quick, DoD 3-Pass, DoD 7-Pass, or Gutmann 35-Pass"
                           FontSize="13"
                           LineBreakMode="WordWrap"/>

                    <Label Text="• Recursive Folder Erase - Option to erase all files in subfolders"
                           FontSize="13"
                           LineBreakMode="WordWrap"/>

                    <Label Text="• Cross-Platform - Works on Windows and Android"
                           FontSize="13"
                           LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Copyright -->
            <Label x:Name="CopyrightLabel"
                   Text="© 2026 Bill Yang. All rights reserved."
                   FontSize="12"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,20,0,0"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
