<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="YXBToolsMAUI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:YXBToolsMAUI"
    xmlns:views="clr-namespace:YXBToolsMAUI.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="YXB Tools">

    <Shell.FlyoutHeader>
        <Grid Padding="20" BackgroundColor="#1e40af">
            <Label Text="🔧 YXB Tools"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"/>
        </Grid>
    </Shell.FlyoutHeader>

    <FlyoutItem Title="Encrypt Files" Icon="dotnet_bot.png">
        <ShellContent
            ContentTemplate="{DataTemplate views:EncryptionPage}"
            Route="EncryptionPage"/>
    </FlyoutItem>

    <FlyoutItem Title="Decrypt Files" Icon="dotnet_bot.png">
        <ShellContent
            ContentTemplate="{DataTemplate views:DecryptionPage}"
            Route="DecryptionPage"/>
    </FlyoutItem>

    <FlyoutItem Title="Erase Files" Icon="dotnet_bot.png">
        <ShellContent
            ContentTemplate="{DataTemplate views:ErasePage}"
            Route="ErasePage"/>
    </FlyoutItem>

    <MenuItem Text="Clear Clipboard" Clicked="OnClearClipboardClicked" />

    <FlyoutItem Title="About" Icon="dotnet_bot.png">
        <ShellContent
            ContentTemplate="{DataTemplate views:AboutPage}"
            Route="AboutPage"/>
    </FlyoutItem>

    <MenuItem Text="Exit" Clicked="OnExitClicked" />

</Shell>
