<UserControl x:Class="HierachicalNotes.ucSearchCriteriaEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HierachicalNotes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"></RowDefinition>
            <RowDefinition Height="26"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>
        <Label Grid.Row="1" Grid.Column="0" Content="Search Method" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top"/>
        <Label Grid.Row="2" Grid.Column="0" Content="Search Pattern(s)" HorizontalAlignment="Left" Margin="10,0,0,0" VerticalAlignment="Top"/>
        <CheckBox Name="cbCaseSensitive" Grid.Column="1" Content="Case Sensitive" HorizontalAlignment="Left" Margin="20,6,0,0" VerticalAlignment="Top"/>
        <CheckBox Name="cbRegularExpression" Grid.Column="1" Content="Regular Expression" HorizontalAlignment="Left" Margin="140,6,0,0" VerticalAlignment="Top"/>
        <CheckBox Name="cbSearchCurrentNode" Grid.Column="1" Content="Search in selected Node" HorizontalAlignment="Left" Margin="340,6,0,0" VerticalAlignment="Top"/>
        <CheckBox Name="cbSearchFrom" IsChecked="false" Grid.Column="1" Content="From" HorizontalAlignment="Left" Margin="560,6,0,0" VerticalAlignment="Top" Checked="cbSearchFrom_Checked"  Unchecked="cbSearchFrom_Unchecked"/>
        <TextBox Name="tbSearchFromDate" IsEnabled="false" Grid.Column="1" HorizontalAlignment="Left" Margin="620,6,0,0" VerticalAlignment="Top" Width="120" Text="" />
        <CheckBox Name="cbSearchTo" IsChecked="false" Grid.Column="1" Content="To" HorizontalAlignment="Left" Margin="760,6,0,0" VerticalAlignment="Top" Checked="cbSearchTo_Checked" Unchecked="cbSearchTo_Unchecked"/>
        <TextBox Name="tbSearchToDate" IsEnabled="false" Grid.Column="1" HorizontalAlignment="Left" Margin="820,6,0,0" VerticalAlignment="Top" Width="120" Text="" />
        <RadioButton Name="rbStrict" Grid.Row="1" Grid.Column="1" Content="Strict" HorizontalAlignment="Left" Margin="20,6,0,0"  VerticalAlignment="Top" IsChecked="True"/>
        <RadioButton Name="rbAnd" Grid.Row="1" Grid.Column="1" Content="And" HorizontalAlignment="Left" Margin="140,6,0,0"  VerticalAlignment="Top"/>
        <RadioButton Name="rbOr" Grid.Row="1" Grid.Column="1" Content="Or" HorizontalAlignment="Left" Margin="260,6,0,0"  VerticalAlignment="Top"/>
        <TextBox Name="tbPattern" AcceptsReturn="True" Grid.Row="2" Grid.Column="2" TextWrapping="Wrap" VerticalScrollBarVisibility="Visible" Text="" />
    </Grid>
</UserControl>
