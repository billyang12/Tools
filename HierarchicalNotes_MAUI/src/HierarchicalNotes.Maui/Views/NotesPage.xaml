<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HierarchicalNotes.Maui.ViewModels"
             x:Class="HierarchicalNotes.Maui.Views.NotesPage"
             x:Name="RootPage"
             Title="Notes">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New" Order="Secondary" Clicked="NewClicked" />
        <ToolbarItem Text="Open" Order="Secondary" Clicked="OpenClicked" />
        <ToolbarItem Text="Save" Order="Secondary" Clicked="SaveClicked" />
        <ToolbarItem Text="Save As" Order="Secondary" Clicked="SaveAsClicked" />
        <ToolbarItem Text="Backup" Order="Secondary" Clicked="BackupClicked" />
        <ToolbarItem Text="Password" Order="Secondary" Clicked="PasswordClicked" />
        <ToolbarItem Text="Export HTML" Order="Secondary" Clicked="ExportHtmlClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*" Padding="{OnIdiom Phone='0', Default='10'}" RowSpacing="10">
        <Grid x:Name="MainSplitGrid" Grid.Row="0" ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TreeColumn" Width="{OnIdiom Phone='150', Default='2*'}" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition x:Name="EditorColumn" Width="{OnIdiom Phone='*', Default='3*'}" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
                <Label Text="Hierarchy" FontSize="20" FontAttributes="Bold" />
                <Label Grid.Row="1"
                       Text="{Binding SelectedNode.Path, StringFormat='Path: {0}'}"
                       FontSize="12"
                       TextColor="#666666"
                       LineBreakMode="HeadTruncation"
                       MaxLines="2" />
                <CollectionView Grid.Row="2" x:Name="NotesCollection"
                                ItemsSource="{Binding VisibleNodes}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedNode, Mode=TwoWay}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:NoteNodeViewModel">
                            <Grid Padding="{Binding Indent}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter TargetName="ItemBorder" Property="Border.BackgroundColor" Value="White" />
                                                    <Setter TargetName="ItemBorder" Property="Border.Stroke" Value="#D0D0D0" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter TargetName="ItemBorder" Property="Border.BackgroundColor" Value="#DDEBFF" />
                                                    <Setter TargetName="ItemBorder" Property="Border.Stroke" Value="#2B78E4" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="ItemBorder"
                                        StrokeShape="RoundRectangle 8"
                                        Stroke="#D0D0D0"
                                        Padding="8"
                                        Margin="0,0,0,8"
                                        BackgroundColor="White">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto">
                                        <Button Grid.Column="0"
                                                Text="{Binding ExpandGlyph}"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                FontSize="18"
                                                FontAttributes="Bold"
                                                Padding="0"
                                                CornerRadius="6"
                                                BackgroundColor="#F0F0F0"
                                                TextColor="#202020"
                                                IsVisible="{Binding HasChildren}"
                                                Command="{Binding Source={x:Reference RootPage}, Path=BindingContext.ToggleExpandCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding DisplayTitle}"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="2"
                                               Text="{Binding UpdateTimeText}"
                                               FontSize="12"
                                               TextColor="Gray"
                                               VerticalOptions="Center" />
                                        <Button Grid.Column="3"
                                                Text="⋯"
                                                WidthRequest="34"
                                                HeightRequest="34"
                                                FontSize="20"
                                                FontAttributes="Bold"
                                                Padding="0"
                                                CornerRadius="6"
                                                BackgroundColor="#F0F0F0"
                                                TextColor="#202020"
                                                Clicked="NodeActionsClicked" />
                                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="{Binding DisplaySummary}"
                                               FontSize="12"
                                               TextColor="#555555"
                                               LineBreakMode="TailTruncation" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>

            <Grid Grid.Column="1"
                  BackgroundColor="#F5F5F5"
                  InputTransparent="False">
                <Grid.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnSplitterPanUpdated" TouchPoints="1" />
                </Grid.GestureRecognizers>
                <BoxView BackgroundColor="#D0D0D0"
                         HorizontalOptions="Center"
                         VerticalOptions="Fill"
                         WidthRequest="6">
                    <BoxView.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnSplitterPanUpdated" TouchPoints="1" />
                    </BoxView.GestureRecognizers>
                </BoxView>
            </Grid>

            <ScrollView Grid.Column="2">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Editor" FontSize="20" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">
                        <Label Text="Name" Grid.Row="0" Grid.Column="0" VerticalOptions="Center" />
                        <Entry Grid.Row="0" Grid.Column="1" Text="{Binding SelectedNode.Name, Mode=TwoWay}" Placeholder="Note name" />

                        <Label Text="Password" Grid.Row="1" Grid.Column="0" VerticalOptions="Center" />
                        <Entry Grid.Row="1" Grid.Column="1" Text="{Binding SelectedNode.Password, Mode=TwoWay}" IsPassword="True" Placeholder="Optional password" />

                        <Label Text="Created" Grid.Row="2" Grid.Column="0" VerticalOptions="Center" />
                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding SelectedNode.CreateTimeText}" VerticalOptions="Center" />

                        <Label Text="Updated" Grid.Row="3" Grid.Column="0" VerticalOptions="Center" />
                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding SelectedNode.UpdateTimeText}" VerticalOptions="Center" />

                        <Label Text="Content" Grid.Row="4" Grid.Column="0" VerticalOptions="Start" />
                        <Editor x:Name="ContentEditor" Grid.Row="4" Grid.Column="1"
                                AutoSize="TextChanges"
                                HeightRequest="260"
                                Text="{Binding SelectedNode.Content, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="6">
                        <SearchBar x:Name="ContentSearchBar" Grid.Column="0" Placeholder="Find in current note" Text="{Binding ContentSearchPattern, Mode=TwoWay}" SearchButtonPressed="ContentSearchButtonPressed" />
                        <Button Grid.Column="1" Text="Find" Clicked="ContentFindClicked" />
                        <Button Grid.Column="2" Text="First" Command="{Binding ContentFirstCommand}" />
                        <Button Grid.Column="3" Text="Prev" Command="{Binding ContentPreviousCommand}" />
                        <Button Grid.Column="4" Text="Next" Command="{Binding ContentNextCommand}" />
                        <Button Grid.Column="5" Text="Last" Command="{Binding ContentLastCommand}" />
                    </Grid>
                    <Label Text="{Binding ContentSearchStatus}" TextColor="Gray" />

                    <Label Text="Preview" FontSize="20" FontAttributes="Bold" />
                    <WebView x:Name="PreviewWebView" HeightRequest="350" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
