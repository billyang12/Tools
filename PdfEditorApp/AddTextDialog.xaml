<Window x:Class="PdfEditorApp.AddTextDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Text" Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter text to add:" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBox Grid.Row="1" x:Name="TextContentBox"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Height="80"
                 Margin="0,0,0,15"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="X Position:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="XPositionBox" Width="100" Text="100" Margin="5,0"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Y Position:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="YPositionBox" Width="100" Text="700" Margin="5,0"/>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="Note: Y coordinates increase from bottom to top in PDF"
                   FontSize="10" Foreground="Gray" TextWrapping="Wrap" Margin="0,10"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Click="OK_Click" MinWidth="80" Margin="5"/>
            <Button Content="Cancel" Click="Cancel_Click" MinWidth="80" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
