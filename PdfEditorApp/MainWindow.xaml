<Window x:Class="PdfEditorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PdfEditorApp"
        mc:Ignorable="d"
        Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1976D2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#CCCCCC"/>
                                <Setter Property="Foreground" Value="#666666"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF9800"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#F44336"/>
        </Style>

        <!-- Fix MenuItem styling for better readability -->
        <Style TargetType="MenuItem">
            <Setter Property="Padding" Value="10,5"/>
            <Style.Triggers>
                <!-- Top-level menu items (in the menu bar) -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Role}" Value="TopLevelHeader">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="Transparent"/>
                </DataTrigger>
                <!-- Submenu items (dropdown items) -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Role}" Value="SubmenuItem">
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Background" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Role}" Value="SubmenuHeader">
                    <Setter Property="Foreground" Value="Black"/>
                    <Setter Property="Background" Value="White"/>
                </DataTrigger>
                <!-- Highlight effect -->
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#2196F3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="#263238" Foreground="White">
            <MenuItem Header="_File" Foreground="White">
                <MenuItem Header="_Open PDF" Command="{Binding OpenCommand}"/>
                <MenuItem Header="_Save As" Command="{Binding SaveAsCommand}"/>
                <Separator/>
                <MenuItem Header="_Exit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit" Foreground="White">
                <MenuItem Header="_Content Editor (Edit Text/Images)" Click="ContentEditor_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools" Foreground="White">
                <MenuItem Header="_Merge PDFs" Command="{Binding MergePdfsCommand}"/>
                <MenuItem Header="_Split PDF" Command="{Binding SplitPdfCommand}"/>
                <MenuItem Header="_Convert Images to PDF" Command="{Binding ConvertImagesToPdfCommand}"/>
                <Separator/>
                <MenuItem Header="_Reorder Pages (Move Page)" Click="ReorderPages_Click"/>
                <Separator/>
                <MenuItem Header="_Export Current Page as Image" Click="ExportPageAsImage_Click"/>
                <MenuItem Header="Export _All Pages as Images" Click="ExportAllPagesAsImages_Click"/>
                <MenuItem Header="Export All Pages as _One Image" Click="ExportAllPagesAsOneImage_Click"/>
                <MenuItem Header="Export PDF to _Word Document" Click="ExportToWord_Click"/>
                <Separator/>
                <MenuItem Header="_Encrypt PDF" Command="{Binding EncryptPdfCommand}"/>
            </MenuItem>
            <MenuItem Header="_Help" Foreground="White">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Toolbar -->
        <ToolBar Grid.Row="1" Background="#37474F" Padding="10,5">
            <Button Command="{Binding OpenCommand}" ToolTip="Open PDF">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📂 " FontSize="16"/>
                    <TextBlock Text="Open" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Click="ContentEditor_Click" ToolTip="Edit PDF Content (Text/Images)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✏️ " FontSize="16"/>
                    <TextBlock Text="Edit Content" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding MergePdfsCommand}" ToolTip="Merge PDFs">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔗 " FontSize="16"/>
                    <TextBlock Text="Merge" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding SplitPdfCommand}" ToolTip="Split PDF">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✂️ " FontSize="16"/>
                    <TextBlock Text="Split" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding AddWatermarkCommand}" ToolTip="Add Watermark">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="💧 " FontSize="16"/>
                    <TextBlock Text="Watermark" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding EncryptPdfCommand}" ToolTip="Encrypt PDF">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔒 " FontSize="16"/>
                    <TextBlock Text="Encrypt" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Separator/>
            <Button Command="{Binding ConvertImagesToPdfCommand}" ToolTip="Convert Images to PDF">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🖼️ " FontSize="16"/>
                    <TextBlock Text="Images→PDF" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </ToolBar>

        <!-- Main Content Area -->
        <Grid x:Name="MainContentGrid" Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" MinWidth="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Thumbnail Sidebar -->
            <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#CCCCCC" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Background="#263238">
                        <Button x:Name="ToggleThumbnailsButton" Content="◀" Width="25" Height="25"
                                Click="ToggleThumbnails_Click" Margin="5"
                                ToolTip="Hide thumbnails" FontSize="10" DockPanel.Dock="Right"
                                IsCancel="False" IsDefault="False" Focusable="False"/>
                        <TextBlock Text="Pages" Foreground="White" FontWeight="Bold"
                                  VerticalAlignment="Center" Margin="10,5"/>
                    </DockPanel>

                    <ScrollViewer x:Name="ThumbnailScrollViewer" Grid.Row="1"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 ScrollChanged="ThumbnailScrollViewer_ScrollChanged">
                        <ItemsControl x:Name="ThumbnailPanel" Margin="5">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{Binding BorderBrush}" BorderThickness="2"
                                           Margin="5" Background="White" Cursor="Hand"
                                           MouseLeftButtonDown="Thumbnail_Click"
                                           Tag="{Binding PageNumber}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0" Height="180">
                                                <Image Source="{Binding ThumbnailImage}"
                                                      Stretch="Uniform" Margin="5"/>
                                                <TextBlock Text="Loading..."
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Foreground="#999999"
                                                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>

                                            <Border Grid.Row="1" Background="#263238" Padding="3">
                                                <TextBlock Text="{Binding PageNumber}"
                                                          Foreground="White"
                                                          HorizontalAlignment="Center"
                                                          FontSize="11" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- GridSplitter for resizing -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"
                         Background="Transparent" ShowsPreview="False"/>

            <!-- Left Panel - Operations -->
            <Border Grid.Column="2" Background="#ECEFF1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PDF Operations" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#263238"/>

                        <!-- File Info -->
                        <GroupBox Header="File Information" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentFileName}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock>
                                    <Run Text="Total Pages: "/>
                                    <Run Text="{Binding TotalPages}" FontWeight="Bold"/>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>

                        <!-- Page Navigation -->
                        <GroupBox Header="Page Navigation" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                                    <Button Command="{Binding PreviousPageCommand}" Content="◀ Previous" MinWidth="80"/>
                                    <TextBlock VerticalAlignment="Center" Margin="10,0">
                                        <Run Text="Page "/>
                                        <Run Text="{Binding SelectedPageNumber}" FontWeight="Bold"/>
                                        <Run Text=" of "/>
                                        <Run Text="{Binding TotalPages}" FontWeight="Bold"/>
                                    </TextBlock>
                                    <Button Command="{Binding NextPageCommand}" Content="Next ▶" MinWidth="80"/>
                                </StackPanel>
                                <TextBox Text="{Binding SelectedPageNumber, UpdateSourceTrigger=PropertyChanged}"
                                       HorizontalAlignment="Center" Width="80" Margin="5"
                                       TextAlignment="Center"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Page Operations -->
                        <GroupBox Header="Page Operations" Margin="0,0,0,10">
                            <StackPanel>
                                <Button Command="{Binding DeletePageCommand}"
                                      Style="{StaticResource DangerButton}"
                                      Content="🗑️ Delete Current Page"/>
                                <Button Command="{Binding RotatePageCommand}"
                                      CommandParameter="90"
                                      Content="↻ Rotate 90° CW"/>
                                <Button Command="{Binding RotatePageCommand}"
                                      CommandParameter="-90"
                                      Content="↺ Rotate 90° CCW"/>
                                <Button Command="{Binding RotatePageCommand}"
                                      CommandParameter="180"
                                      Content="↻ Rotate 180°"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Document Operations -->
                        <GroupBox Header="Document Operations" Margin="0,0,0,10">
                            <StackPanel>
                                <Button Command="{Binding AddWatermarkCommand}"
                                      Content="💧 Add Watermark"/>
                                <Button Command="{Binding EncryptPdfCommand}"
                                      Style="{StaticResource SecondaryButton}"
                                      Content="🔒 Encrypt PDF"/>
                                <Button Command="{Binding ExtractTextCommand}"
                                      Content="📝 Extract Text (Current Page)"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Batch Operations -->
                        <GroupBox Header="Batch Operations" Margin="0,0,0,10">
                            <StackPanel>
                                <Button Command="{Binding MergePdfsCommand}"
                                      Content="🔗 Merge Multiple PDFs"/>
                                <Button Command="{Binding SplitPdfCommand}"
                                      Content="✂️ Split PDF into Pages"/>
                                <Button Command="{Binding ConvertImagesToPdfCommand}"
                                      Content="🖼️ Convert Images to PDF"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right Panel - Preview & Text -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- PDF Preview Area -->
                <Border Grid.Row="0" Background="White" CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="PDF Preview Area"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 FontSize="24"
                                 Foreground="#CCCCCC"
                                 Visibility="{Binding CurrentPdfPath, Converter={StaticResource NullToVisibilityConverter}}"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding CurrentFileName}"
                                         FontSize="16" FontWeight="Bold"
                                         Margin="10"
                                         HorizontalAlignment="Center"/>
                                <TextBlock Text="Preview functionality requires additional rendering library"
                                         Margin="10"
                                         HorizontalAlignment="Center"
                                         Foreground="#666666"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                            Background="#CCCCCC" ResizeDirection="Rows"/>

                <!-- Extracted Text Area -->
                <Border Grid.Row="2" Background="White" CornerRadius="8" BorderBrush="#CCCCCC" BorderThickness="1" Margin="0,5,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Extracted Text"
                                 FontSize="14" FontWeight="Bold"
                                 Margin="10,10,10,5"
                                 Foreground="#263238"/>

                        <TextBox Grid.Row="1"
                               Text="{Binding ExtractedText}"
                               IsReadOnly="True"
                               TextWrapping="Wrap"
                               AcceptsReturn="True"
                               VerticalScrollBarVisibility="Auto"
                               Margin="10,0,10,10"
                               Background="#FAFAFA"
                               BorderThickness="0"
                               FontFamily="Consolas"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="3" Background="#263238" Padding="10,5">
            <TextBlock Text="{Binding StatusMessage}"
                     Foreground="White"
                     VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
