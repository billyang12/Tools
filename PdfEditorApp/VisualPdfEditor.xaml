<Window x:Class="PdfEditorApp.VisualPdfEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Visual PDF Editor - Edit PDFs Directly" Height="900" Width="1600"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#2196F3"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#263238" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- File Operations -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Click="OpenPdf_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂 " FontSize="16"/>
                            <TextBlock Text="Open PDF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Click="SavePdf_Click" x:Name="SaveButton" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾 " FontSize="16"/>
                            <TextBlock Text="Save Changes" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Page Navigation -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Click="PreviousPage_Click" x:Name="PrevButton" Content="◀ Previous" IsEnabled="False"/>
                    <TextBlock VerticalAlignment="Center" Margin="10,0" Foreground="White">
                        <Run Text="Page "/>
                        <Run x:Name="CurrentPageText" Text="0"/>
                        <Run Text=" of "/>
                        <Run x:Name="TotalPagesText" Text="0"/>
                    </TextBlock>
                    <Button Click="NextPage_Click" x:Name="NextButton" Content="Next ▶" IsEnabled="False"/>
                    <Separator Margin="10,0"/>
                    <TextBlock Text="Zoom:" VerticalAlignment="Center" Foreground="White" Margin="10,0,5,0"/>
                    <Button Click="ZoomOut_Click" Content="-" MinWidth="35"/>
                    <TextBlock x:Name="ZoomText" Text="100%" VerticalAlignment="Center" Foreground="White" MinWidth="50" TextAlignment="Center"/>
                    <Button Click="ZoomIn_Click" Content="+" MinWidth="35"/>
                </StackPanel>

                <!-- Edit Mode -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="Edit Mode:" VerticalAlignment="Center" Foreground="White" Margin="10,0,5,0"/>
                    <RadioButton x:Name="SelectModeRadio" Content="Select" IsChecked="True"
                                Foreground="White" VerticalAlignment="Center" Margin="5,0" GroupName="EditMode"
                                Checked="EditMode_Changed"/>
                    <RadioButton x:Name="TextModeRadio" Content="Edit Text"
                                Foreground="White" VerticalAlignment="Center" Margin="5,0" GroupName="EditMode"
                                Checked="EditMode_Changed"/>
                    <RadioButton x:Name="ImageModeRadio" Content="Add Image"
                                Foreground="White" VerticalAlignment="Center" Margin="5,0" GroupName="EditMode"
                                Checked="EditMode_Changed"/>
                    <RadioButton x:Name="EraseModeRadio" Content="Erase"
                                Foreground="White" VerticalAlignment="Center" Margin="5,0" GroupName="EditMode"
                                Checked="EditMode_Changed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar - Tools -->
            <Border Grid.Column="0" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Editing Tools" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <!-- Text Tools -->
                        <GroupBox Header="Text Editing" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Click on text to edit it" TextWrapping="Wrap" Margin="0,5" FontSize="11" Foreground="Gray"/>

                                <TextBlock Text="Font Size:" Margin="0,10,0,2"/>
                                <Slider x:Name="FontSizeSlider" Minimum="8" Maximum="72" Value="12"
                                       TickFrequency="4" IsSnapToTickEnabled="True"/>
                                <TextBlock Text="{Binding ElementName=FontSizeSlider, Path=Value, StringFormat={}{0:F0}pt}"
                                         HorizontalAlignment="Center"/>

                                <TextBlock Text="Font Family:" Margin="0,10,0,2"/>
                                <ComboBox x:Name="FontFamilyCombo" SelectedIndex="0">
                                    <ComboBoxItem Content="Helvetica"/>
                                    <ComboBoxItem Content="Times"/>
                                    <ComboBoxItem Content="Courier"/>
                                </ComboBox>

                                <TextBlock Text="Text Color:" Margin="0,10,0,2"/>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="BlackTextRadio" Content="Black" IsChecked="True" Margin="0,0,10,0"/>
                                    <RadioButton x:Name="RedTextRadio" Content="Red" Margin="0,0,10,0"/>
                                    <RadioButton x:Name="BlueTextRadio" Content="Blue"/>
                                </StackPanel>

                                <Button Click="AddTextBox_Click" Content="Add New Text Box" Margin="0,10"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Image Tools -->
                        <GroupBox Header="Image Tools" Margin="0,0,0,10">
                            <StackPanel>
                                <Button Click="SelectAndAddImage_Click" Margin="0,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📷 " FontSize="16"/>
                                        <TextBlock Text="Select &amp; Add Image" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="SelectedImageLabel" Text="No image selected"
                                         TextWrapping="Wrap" Margin="0,5" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Erase Tool -->
                        <GroupBox Header="Erase Tool" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="Click and drag on PDF to erase content"
                                         TextWrapping="Wrap" Margin="0,5" FontSize="11" Foreground="Gray"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Quick Actions -->
                        <GroupBox Header="Quick Actions" Margin="0,0,0,10">
                            <StackPanel>
                                <Button Click="HighlightText_Click" Margin="0,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖍 " FontSize="16"/>
                                        <TextBlock Text="Highlight Selected" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="UnderlineText_Click" Margin="0,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➖ " FontSize="16"/>
                                        <TextBlock Text="Underline Selected" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="AddWatermark_Click" Margin="0,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="💧 " FontSize="16"/>
                                        <TextBlock Text="Add Watermark" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="ExportPageAsImage_Click" Margin="0,5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖼️ " FontSize="16"/>
                                        <TextBlock Text="Export Page as Image" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Center - PDF Viewer with Overlay -->
            <Border Grid.Column="1" Background="#E0E0E0">
                <ScrollViewer x:Name="PdfScrollViewer"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto"
                            Background="#E0E0E0">
                    <Grid>
                        <!-- PDF Image Display -->
                        <Image x:Name="PdfImage"
                             Stretch="None"
                             MouseLeftButtonDown="PdfImage_MouseDown"
                             MouseMove="PdfImage_MouseMove"
                             MouseLeftButtonUp="PdfImage_MouseUp"
                             Cursor="Cross"/>

                        <!-- Overlay Canvas for Editing Markers -->
                        <Canvas x:Name="EditingCanvas"
                              Background="Transparent"
                              MouseLeftButtonDown="EditingCanvas_MouseDown"
                              MouseMove="EditingCanvas_MouseMove"
                              MouseLeftButtonUp="EditingCanvas_MouseUp"/>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Right Sidebar - Properties & History -->
            <Border Grid.Column="2" Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Properties" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                        <!-- File Info -->
                        <GroupBox Header="Document Info" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="FileNameText" Text="No file open" TextWrapping="Wrap" FontWeight="Bold"/>
                                <TextBlock x:Name="FileSizeText" Text="" Margin="0,5,0,0"/>
                                <TextBlock x:Name="PageSizeText" Text="" Margin="0,5,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Current Selection -->
                        <GroupBox Header="Current Selection" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="SelectionText" Text="Nothing selected" TextWrapping="Wrap"/>
                                <TextBlock x:Name="PositionText" Text="" Margin="0,5,0,0"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Edit History -->
                        <GroupBox Header="Recent Edits" Margin="0,0,0,10">
                            <ListBox x:Name="EditHistoryList" Height="200">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </GroupBox>

                        <!-- Instructions -->
                        <GroupBox Header="Instructions" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#666">
                                    <Run Text="1. Open a PDF file"/>
                                    <LineBreak/>
                                    <Run Text="2. Click 'Edit Text' mode"/>
                                    <LineBreak/>
                                    <Run Text="3. Click on text to edit"/>
                                    <LineBreak/>
                                    <Run Text="4. Or click 'Add Image' and click where to place it"/>
                                    <LineBreak/>
                                    <Run Text="5. Use 'Erase' mode to remove content"/>
                                    <LineBreak/>
                                    <Run Text="6. Save your changes"/>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#263238" Padding="10,5">
            <Grid>
                <TextBlock x:Name="StatusText"
                         Text="Ready - Open a PDF file to start editing"
                         Foreground="White"
                         VerticalAlignment="Center"/>
                <TextBlock x:Name="MousePositionText"
                         Text=""
                         Foreground="White"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>
