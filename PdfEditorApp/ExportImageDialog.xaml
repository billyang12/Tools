<Window x:Class="PdfEditorApp.ExportImageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Image Settings" Height="280" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- DPI Selection -->
        <TextBlock Grid.Row="0" Text="Image Quality (DPI):" Margin="0,5,0,5" FontWeight="Bold"/>
        <ComboBox x:Name="DpiCombo" Grid.Row="1" SelectedIndex="1" Margin="0,0,0,15">
            <ComboBoxItem Content="72 DPI (Screen Quality)"/>
            <ComboBoxItem Content="150 DPI (Standard Quality)"/>
            <ComboBoxItem Content="300 DPI (High Quality)"/>
            <ComboBoxItem Content="600 DPI (Print Quality)"/>
        </ComboBox>

        <!-- Format Selection -->
        <TextBlock Grid.Row="2" Text="Image Format:" Margin="0,5,0,5" FontWeight="Bold"/>
        <ComboBox x:Name="FormatCombo" Grid.Row="3" SelectedIndex="0" Margin="0,0,0,15">
            <ComboBoxItem Content="PNG (Lossless, Best Quality)"/>
            <ComboBoxItem Content="JPEG (Compressed, Smaller Size)"/>
            <ComboBoxItem Content="BMP (Uncompressed, Large Size)"/>
        </ComboBox>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Export" Width="80" Height="30" Margin="5" Click="Export_Click" IsDefault="True"/>
            <Button Content="Cancel" Width="80" Height="30" Margin="5" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
