<Window x:Class="PdfEditorApp.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Text" Height="250" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter text to add:" FontWeight="Bold" Margin="0,0,0,10"/>

        <TextBox Grid.Row="1" x:Name="TextContentBox"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,15"/>

        <TextBlock Grid.Row="2" Text="Tip: You can enter multiple lines"
                   FontSize="11" Foreground="Gray" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Click="OK_Click" MinWidth="80" Margin="5"
                   Background="#4CAF50" Foreground="White" BorderThickness="0" Padding="10,5"/>
            <Button Content="Cancel" Click="Cancel_Click" MinWidth="80" Margin="5"
                   Background="#757575" Foreground="White" BorderThickness="0" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>
