<Window x:Class="PdfEditorApp.PageReorderDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PdfEditorApp"
        Title="Reorder Pages" Height="600" Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinWidth="800" MinHeight="500">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Controls -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Page Order" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

            <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Padding="5">
                <ListBox x:Name="PageListBox" SelectionMode="Single" SelectionChanged="PageListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Position}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Grid.Column="1" Text="{Binding Description}" FontSize="12" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,10">
                <Button x:Name="MoveUpButton" Content="⬆ Move Up" Margin="0,2" Click="MoveUp_Click"/>
                <Button x:Name="MoveDownButton" Content="⬇ Move Down" Margin="0,2" Click="MoveDown_Click"/>
                <Button x:Name="MoveToButton" Content="Move to Position..." Margin="0,2" Click="MoveTo_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Save" Width="80" Margin="5" Click="Save_Click" IsDefault="True"
                        Background="#4CAF50" Foreground="White" Padding="10,5"/>
                <Button Content="Cancel" Width="80" Margin="5" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </Grid>

        <!-- Right Panel - Preview -->
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Preview" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="LoadingText" Text=" (Loading thumbnails...)" FontSize="12"
                          VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#666666" Visibility="Collapsed"/>
            </StackPanel>

            <Border Grid.Row="1" BorderBrush="#CCCCCC" BorderThickness="1" Background="#F5F5F5">
                <ScrollViewer x:Name="PreviewScrollViewer"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             ScrollChanged="PreviewScrollViewer_ScrollChanged">
                    <ItemsControl x:Name="ThumbnailsPanel" Margin="5">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#999999" BorderThickness="1" Margin="5" Background="White"
                                        Width="150" Height="200">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Thumbnail Image -->
                                        <Grid Grid.Row="0">
                                            <Image x:Name="ThumbnailImage"
                                                  Source="{Binding ThumbnailImage}"
                                                  Stretch="Uniform"
                                                  Margin="5"/>
                                            <TextBlock Text="Loading..."
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="#999999"
                                                      Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                        </Grid>

                                        <!-- Page Number -->
                                        <Border Grid.Row="1" Background="#263238" Padding="5">
                                            <TextBlock Text="{Binding DisplayText}"
                                                      Foreground="White"
                                                      FontWeight="Bold"
                                                      HorizontalAlignment="Center"
                                                      FontSize="12"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
