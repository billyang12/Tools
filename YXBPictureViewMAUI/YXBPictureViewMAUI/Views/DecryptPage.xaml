<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="YXBPictureViewMAUI.Views.DecryptPage"
             Title="Decrypt Images">

    <AbsoluteLayout>
        <ScrollView Padding="20"
                    AbsoluteLayout.LayoutBounds="0,0,1,1"
                    AbsoluteLayout.LayoutFlags="All">
            <VerticalStackLayout Spacing="15">

                <!-- Password Section -->
                <Frame BorderColor="Gray" Padding="15">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="XPG Password" FontAttributes="Bold" FontSize="16"/>
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <Entry x:Name="txtPassword"
                                   Grid.Column="0"
                                   Placeholder="Enter password or key"
                                   IsPassword="True"
                                   TextChanged="OnPasswordChanged"/>
                            <Button x:Name="btnCopyKey"
                                    Grid.Column="1"
                                    Text="📋"
                                    Clicked="OnCopyKey"
                                    IsVisible="False"
                                    WidthRequest="40"
                                    Margin="5,0,0,0"
                                    ToolTipProperties.Text="Copy key to clipboard"/>
                            <Button Grid.Column="2"
                                    Text="Generate"
                                    Clicked="OnGenerateKey"
                                    Margin="5,0,0,0"/>
                            <Button Grid.Column="3"
                                    Text="From Password"
                                    Clicked="OnDeriveKey"
                                    Margin="5,0,0,0"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

            <!-- Source Folder Section -->
            <Frame BorderColor="Gray" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Source Folder" FontAttributes="Bold" FontSize="16"/>
                    <Label x:Name="lblSourceFolder"
                           Text="No folder selected"
                           TextColor="Gray"/>
                    <Button x:Name="btnSelectSource"
                            Text="Select Folder with XPG Files"
                            Clicked="OnSelectSourceFolder"
                            BackgroundColor="{StaticResource Primary}"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Options Section -->
            <Frame BorderColor="Gray" Padding="15">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Options" FontAttributes="Bold" FontSize="16"/>

                    <Label Text="Output File Type:"/>
                    <Picker x:Name="pickerOutputExt">
                        <Picker.Items>
                            <x:String>jpg</x:String>
                            <x:String>png</x:String>
                            <x:String>bmp</x:String>
                        </Picker.Items>
                    </Picker>

                    <CheckBox x:Name="chkIncludeSubfolders"/>
                    <Label Text="Include subfolders"
                           VerticalOptions="Center"/>

                    <CheckBox x:Name="chkDeleteOriginal"/>
                    <Label Text="Delete XPG files after decryption"
                           TextColor="Red"
                           VerticalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <!-- Decrypt Button -->
            <Button x:Name="btnDecrypt"
                    Text="Start Decryption"
                    Clicked="OnDecrypt"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    HeightRequest="60"
                    FontSize="18"
                    FontAttributes="Bold"/>

            <!-- Progress Section -->
            <Frame BorderColor="Gray" Padding="15" IsVisible="False" x:Name="frameProgress">
                <VerticalStackLayout Spacing="10">
                    <Label x:Name="lblProgress" Text="Processing..." FontAttributes="Bold"/>
                    <ProgressBar x:Name="progressBar" Progress="0"/>
                    <Label x:Name="lblProgressDetail" Text="0 / 0" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Dialog overlay container (always on top) -->
        <ContentView x:Name="dialogOverlay"
                     IsVisible="False"
                     AbsoluteLayout.LayoutBounds="0,0,1,1"
                     AbsoluteLayout.LayoutFlags="All"/>
    </AbsoluteLayout>
</ContentPage>
