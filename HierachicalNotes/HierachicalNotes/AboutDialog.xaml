<Window x:Class="HierachicalNotes.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Hierarchical Notes"
        Height="300"
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F5F5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Icon and Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Image Source="icon.ico" Width="64" Height="64" Margin="0,0,15,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Hierarchical Notes" FontSize="24" FontWeight="Bold" Foreground="#357ABD"/>
                <TextBlock x:Name="txtVersion" Text="Version 1.0" FontSize="14" Foreground="#666" Margin="0,5,0,0"/>
                <TextBlock Text="Developed by Bill Yang" FontSize="12" Foreground="#888" Margin="0,3,0,0" FontStyle="Italic"/>
            </StackPanel>
        </StackPanel>

        <!-- Description -->
        <Border Grid.Row="1" Background="White" Padding="15" CornerRadius="5" BorderBrush="#DDD" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" LineHeight="22" Foreground="#333">
                A powerful hierarchical note-taking application that helps you organize your thoughts, ideas, and information in a tree structure. Features include password protection, search functionality, and HTML export.
            </TextBlock>
        </Border>

        <!-- Additional Info -->
        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <TextBlock Text="Features:" FontWeight="Bold" FontSize="12" Foreground="#357ABD" Margin="0,0,0,5"/>
            <TextBlock Text="• Hierarchical tree structure for notes" FontSize="11" Foreground="#555" Margin="5,0,0,3"/>
            <TextBlock Text="• Password protection for sensitive data" FontSize="11" Foreground="#555" Margin="5,0,0,3"/>
            <TextBlock Text="• Full-text search capabilities" FontSize="11" Foreground="#555" Margin="5,0,0,3"/>
            <TextBlock Text="• Export to HTML format" FontSize="11" Foreground="#555" Margin="5,0,0,3"/>
            <TextBlock Text="• Drag and drop organization" FontSize="11" Foreground="#555" Margin="5,0,0,3"/>
        </StackPanel>

        <!-- OK Button -->
        <Button Grid.Row="3" Content="OK" Width="80" Height="30"
                HorizontalAlignment="Center" Margin="0,15,0,0"
                Click="OkButton_Click">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#4A90E2"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="3"
                                        Padding="15,5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#357ABD"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
    </Grid>
</Window>
